{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "OpenApi Spec Hista",
			"command": "encore",
			"args": [
				"gen",
				"client",
				"-l",
				"typescript",
				"--services",
				"hista,authentication",
				"-e",
				"local",
				"-o",
				"C:\\Users\\Test\\Documents\\Code\\hista-ui\\src\\api\\generatedApi.ts",
			],
			"icon": {
				"id": "broadcast"
			},
			"group": "build",
			"presentation": {
				"reveal": "silent",
				"revealProblems": "onProblem",
				"close": true,
			},
		},
		{
			"type": "shell",
			"label": "OpenApi Spec ShoppingList",
			"command": "encore",
			"args": [
				"gen",
				"client",
				"-l",
				"typescript",
				"-e",
				"local",
				"--services",
				"shoppinglist,authentication",
				"-o",
				"C:\\Users\\Test\\Documents\\Code\\shopping-list-ui\\src\\api\\generatedApi.ts",
			],
			"icon": {
				"id": "broadcast"
			},
			"group": "build",
			"presentation": {
				"reveal": "silent",
				"revealProblems": "onProblem",
				"close": true,
			},
		},
		{
			"type": "shell",
			"label": "Run in debug mode",
			"command": "encore",
			"args": [
				"run",
				"--debug"
			],
			"icon": {
				"id": "debug-alt"
			},
		},
		{
			"type": "shell",
			"label": "Test",
			"command": "encore",
			"args": [
				"test",
				"./...",
			],
			"group": "test",
			"icon": {
				"id": "beaker"
			}
		},
		{
			"type": "shell",
			"label": "Atlas: migrate api",
			"command": "sh",
			"args": [
				"${workspaceFolder}/api/scripts/generate-migration",
				" ${input:migrationName}",
			],
			"icon": {
				"id": "arrow-circle-up"
			}
		},
		{
			"type": "shell",
			"label": "Atlas: migrate users",
			"command": "sh",
			"args": [
				"${workspaceFolder}/users/scripts/generate-migration",
				"${input:migrationName}",
			],
			"icon": {
				"id": "arrow-circle-up"
			}
		},
		{
			"type": "shell",
			"label": "Atlas: migrate product mgmt",
			"command": "sh",
			"args": [
				"${workspaceFolder}/product_mgmt/scripts/generate-migration",
				"${input:migrationName}",
			],
			"icon": {
				"id": "arrow-circle-up"
			}
		},
		{
			"type": "shell",
			"label": "Atlas: migrate shopping list",
			"command": "sh",
			"args": [
				"${workspaceFolder}/shoppingList/scripts/generate-migration",
				" ${input:migrationName}",
			],
			"icon": {
				"id": "arrow-circle-up"
			}
		},
		{
			"type": "shell",
			"label": "Atlas: inspect",
			"command": "atlas",
			"args": [
				"schema",
				"inspect",
				"-w",
				"--env",
				"local",
				"--url",
				"'env://src'",
				"--dev-url",
				"'postgresql://hista-api-dpc2:shadow-coglfj3nlv8jiu6322e0@127.0.0.1:9500/hista_db?sslmode=disable&search_path=public'"
			]
		},
		{
			"type": "shell",
			"label": "Run",
			"command": "encore run",
			"icon": {
				"id": "run"
			}
		},
		{
			"type": "shell",
			"label": "Reset database",
			"command": "encore db reset hista_db"
		},
		{
			"type": "shell",
			"label": "Update hash for migrations (hista)",
			"command": "atlas migrate hash",
			"options": {
				"cwd": "${workspaceFolder}/api",
			},
			"presentation": {
				"reveal": "silent",
				"revealProblems": "onProblem",
				"close": true,
			}
		},
		{
			"type": "shell",
			"label": "Update hash for migrations (users)",
			"command": "atlas migrate hash",
			"options": {
				"cwd": "${workspaceFolder}/users",
			},
			"presentation": {
				"reveal": "silent",
				"revealProblems": "onProblem",
				"close": true,
			}
		},
		{
			"type": "shell",
			"label": "Update hash for migrations (product_mgmt)",
			"command": "atlas migrate hash",
			"options": {
				"cwd": "${workspaceFolder}/product_mgmt",
			},
			"presentation": {
				"reveal": "silent",
				"revealProblems": "onProblem",
				"close": true,
			},
		},
		{
			"label": "Update hash for all migrations",
			"dependsOn": [
				"Update hash for migrations (hista)",
				"Update hash for migrations (product_mgmt)",
				"Update hash for migrations (users)"
			],
			"dependsOrder": "parallel", // run one after another (default is parallel)
			"icon": {
				"id": "discard"
			}
		},
		{
			"type": "shell",
			"label": "Detect deadcode",
			"command": "deadcode .",
			"icon": {
				"id": "code"
			}
		}
	],
	"inputs": [
		{
			"id": "migrationName",
			"description": "Name of the new Atlas migration",
			"type": "promptString",
		}
	]
}